  "identity": [
    { "id": "same-device", "bound": { "kind": "device", "id": "iphone-87b42264" }, "claimed": { "kind": "device", "id": "iphone-87b42264" }, "expect": "accept" },
    { "id": "other-device-id", "bound": { "kind": "device", "id": "iphone-87b42264" }, "claimed": { "kind": "device", "id": "iphone-00000000" }, "expect": "reject" },
    { "id": "wrong-kind-same-id", "bound": { "kind": "device", "id": "iphone-87b42264" }, "claimed": { "kind": "renderer", "id": "iphone-87b42264" }, "expect": "reject" },
    { "id": "device-claiming-runtime", "bound": { "kind": "device", "id": "iphone-87b42264" }, "claimed": { "kind": "runtime", "id": "runtime" }, "expect": "reject", "note": "§5 a device may never claim to be the Runtime; the host must not normalise it" },
    { "id": "trusted-host-surface", "bound": { "kind": "human-surface", "id": "desktop" }, "claimed": { "kind": "human-surface", "id": "desktop" }, "expect": "accept" },
    { "id": "other-host-surface", "bound": { "kind": "human-surface", "id": "desktop" }, "claimed": { "kind": "human-surface", "id": "desktop-2" }, "expect": "reject" }
  ],
  "offlinePolicy": [
    { "name": "character.interaction.touch", "hasConsentGrant": false, "expect": "expire-by-deadline" },
    { "name": "character.interaction.dismiss", "hasConsentGrant": false, "expect": "drop-if-offline" },
    { "name": "character.behavior.request", "hasConsentGrant": false, "expect": "drop-if-offline" },
    { "name": "character.behavior.cancel", "hasConsentGrant": false, "expect": "drop-if-offline" },
    { "name": "character.preference.volume", "hasConsentGrant": false, "expect": "queue-idempotent" },
    { "name": "character.session.presence", "hasConsentGrant": false, "expect": "state-reconcile" },
    { "name": "task.state", "hasConsentGrant": false, "expect": "state-reconcile" },
    { "name": "task.verified", "hasConsentGrant": false, "expect": "state-reconcile" },
    { "name": "runtime.emergency", "hasConsentGrant": false, "expect": "state-reconcile" },
    { "name": "character.session.approval", "hasConsentGrant": false, "expect": "require-reconfirmation", "note": "§8 approval-request 的線上名字（approval-request.json 的 name）；它也符合 character.session.* 前綴，歸類必須先判斷 approval，否則人類決定會被當成可自動對齊的狀態" },
    { "name": "approval.request", "hasConsentGrant": false, "expect": "require-reconfirmation" },
    { "name": "character.behavior.request", "hasConsentGrant": true, "expect": "require-reconfirmation", "note": "§8 anything carrying a consentGrantId needs a fresh human decision after a reconnect" },
    { "name": "device.tilt", "hasConsentGrant": false, "expect": "drop-if-offline", "note": "unknown names take the most conservative class" }
  ],
  "outcomeTransitions": [
