{
  "manifestVersion": 1,
  "specVersion": "aip/1.0",
  "note": "AIP 1.0 conformance fixture index. Rust, TypeScript and Swift all read THIS file and must reach the same conclusion for every entry. `expect` is either \"ok\" or \"error\" plus the stable ErrorCode from docs/aip/README.md §12. State fixtures carry a real SHA-256 over canonical JSON of their `state`/patched state, but hash verification itself belongs to interaction-session, not to envelope conformance.",
  "envelopes": [
    { "id": "event-touch", "file": "event-touch.json", "expect": "ok", "note": "§2.2 event profile; also the aip/1.0 (same-minor) version fixture" },
    { "id": "event-dismiss", "file": "event-dismiss.json", "expect": "ok", "note": "§7 every character.interaction.* event carries a deadline, dismiss included" },
    { "id": "command-behavior-request", "file": "command-behavior-request.json", "expect": "ok", "note": "§5 Behavior Intent" },
    { "id": "query-session-resume", "file": "query-session-resume.json", "expect": "ok" },
    { "id": "response-session-resume", "file": "response-session-resume.json", "expect": "ok" },
    { "id": "result-accepted", "file": "result-accepted.json", "expect": "ok" },
    { "id": "result-duplicate", "file": "result-duplicate.json", "expect": "ok", "note": "§7 duplicate messageId is accepted, never re-applied" },
    { "id": "state-snapshot", "file": "state-snapshot.json", "expect": "ok" },
    { "id": "state-patch", "file": "state-patch.json", "expect": "ok", "note": "patch requires baseRevision" },
    { "id": "cancel-behavior", "file": "cancel-behavior.json", "expect": "ok", "note": "cancel by causationId" },
    { "id": "cancel-by-payload-reference", "file": "cancel-by-payload-reference.json", "expect": "ok", "note": "cancel by payload.messageId" },
    { "id": "approval-request", "file": "approval-request.json", "expect": "ok" },
    { "id": "approval-result", "file": "approval-result.json", "expect": "ok" },
    { "id": "error-identity-mismatch", "file": "error-identity-mismatch.json", "expect": "ok" },
    { "id": "heartbeat", "file": "heartbeat.json", "expect": "ok" },
    { "id": "capability-announcement", "file": "capability-announcement.json", "expect": "ok" },
    { "id": "version-minor-1-3", "file": "version-minor-1-3.json", "expect": "ok", "roundTrip": true, "note": "§4.1 a newer minor is accepted and its unknown top-level field survives" },
    { "id": "roundtrip-unknown-optional-field", "file": "roundtrip-unknown-optional-field.json", "expect": "ok", "roundTrip": true, "note": "§1 unknown optional top-level fields are preserved and ignored" },
    { "id": "roundtrip-big-integer-unknown-field", "file": "roundtrip-big-integer-unknown-field.json", "expect": "ok", "roundTrip": true, "note": "§1 round-trip 不遺失：未知欄位帶超過 2^53 的整數（9007199254740993、1000000000000000001）時，重新編碼出來的字面值必須逐字相同；只比對兩個都經過同一條 double 管線的值是驗不出來的" },

    { "id": "invalid-event-missing-session", "file": "invalid-event-missing-session.json", "expect": "error", "code": "schema-invalid", "note": "§2.2 event requires sessionId" },
    { "id": "invalid-name-grammar", "file": "invalid-name-grammar.json", "expect": "error", "code": "schema-invalid", "mustNotEcho": ["Character.Interaction.Touch"] },
    { "id": "invalid-name-single-segment", "file": "invalid-name-single-segment.json", "expect": "error", "code": "schema-invalid", "note": "names need at least two dot-separated segments" },
    { "id": "invalid-occurred-at", "file": "invalid-occurred-at.json", "expect": "error", "code": "schema-invalid", "mustNotEcho": ["yesterday-afternoon-ish"] },
    { "id": "invalid-unknown-message-type", "file": "invalid-unknown-message-type.json", "expect": "error", "code": "unsupported-message-type", "mustNotEcho": ["teleport", "the-moon"], "note": "§4.1 unknown type is never executed and never echoed back" },
    { "id": "invalid-major-mismatch", "file": "invalid-major-mismatch.json", "expect": "error", "code": "unsupported-version" },
    { "id": "invalid-spec-version-syntax", "file": "invalid-spec-version-syntax.json", "expect": "error", "code": "schema-invalid" },
    { "id": "invalid-spec-version-trailing-newline", "file": "invalid-spec-version-trailing-newline.json", "expect": "error", "code": "schema-invalid", "note": "§4.1 版本字串是精確語法：前後空白／換行不得被 trim 掉（trim 的實作與不 trim 的實作會對同一則訊息給出不同結論）" },
    { "id": "invalid-spec-version-trailing-space", "file": "invalid-spec-version-trailing-space.json", "expect": "error", "code": "schema-invalid", "note": "同上：空白也不是版本的一部分" },
    { "id": "invalid-spec-version-minor-overflow", "file": "invalid-spec-version-minor-overflow.json", "expect": "error", "code": "schema-invalid", "note": "§4.1 minor 溢出 u32（aip/1.99999999999）是看不懂的字串，不是「比較新的 minor」" },
    { "id": "invalid-spec-version-major-overflow", "file": "invalid-spec-version-major-overflow.json", "expect": "error", "code": "schema-invalid", "note": "§4.1 major 溢出 u32（aip/5000000000.0）→ schema-invalid，不是 unsupported-version" },
    { "id": "invalid-payload-too-deep", "file": "invalid-payload-too-deep.json", "expect": "error", "code": "schema-invalid", "note": "§11 MAX_JSON_DEPTH = 8" },
    { "id": "invalid-payload-string-too-long", "file": "invalid-payload-string-too-long.json", "expect": "error", "code": "schema-invalid", "note": "§11 MAX_STRING_CHARS = 2000" },
    { "id": "invalid-message-id-too-long", "file": "invalid-message-id-too-long.json", "expect": "error", "code": "schema-invalid", "note": "§11 MAX_ID_CHARS = 128" },
    { "id": "invalid-result-unknown-status", "file": "invalid-result-unknown-status.json", "expect": "error", "code": "schema-invalid", "mustNotEcho": ["totally-finished-trust-me"], "note": "§3 an unknown Outcome is never treated as success" },
    { "id": "invalid-result-missing-causation", "file": "invalid-result-missing-causation.json", "expect": "error", "code": "schema-invalid" },
    { "id": "invalid-command-missing-expiry", "file": "invalid-command-missing-expiry.json", "expect": "error", "code": "schema-invalid", "note": "§7 Behavior Intent must carry a deadline" },
    { "id": "invalid-interaction-missing-expiry", "file": "invalid-interaction-missing-expiry.json", "expect": "error", "code": "schema-invalid" },
    { "id": "invalid-state-patch-missing-base-revision", "file": "invalid-state-patch-missing-base-revision.json", "expect": "error", "code": "schema-invalid" },
    { "id": "invalid-state-revision-out-of-range", "file": "invalid-state-revision-out-of-range.json", "expect": "error", "code": "schema-invalid", "note": "§6 revision 是 u64。1e30 不是 u64：權威 host 拒絕，客戶端也必須拒絕（而不是崩潰或當成很大的數字接受）" },
    { "id": "invalid-state-revision-beyond-u64", "file": "invalid-state-revision-beyond-u64.json", "expect": "error", "code": "schema-invalid", "note": "§6 整數語法但超過 u64 上限（2^64）同樣不是合法 revision" },
    { "id": "invalid-state-integers-written-as-floats", "file": "invalid-state-integers-written-as-floats.json", "expect": "error", "code": "schema-invalid", "note": "§1／§6 sequence／baseRevision／payload.revision 必須寫成 JSON 整數；1.0 這種浮點字面值權威 host 不收，客戶端也不得放行" },
    { "id": "invalid-cancel-missing-reference", "file": "invalid-cancel-missing-reference.json", "expect": "error", "code": "schema-invalid" },
    { "id": "invalid-approval-request-target-not-human", "file": "invalid-approval-request-target-not-human.json", "expect": "error", "code": "schema-invalid", "note": "§2.2 only a human may be asked to approve" },
    { "id": "invalid-source-kind-unknown", "file": "invalid-source-kind-unknown.json", "expect": "error", "code": "schema-invalid", "mustNotEcho": ["space-probe", "voyager-2"] },
    { "id": "invalid-error-missing-code", "file": "invalid-error-missing-code.json", "expect": "error", "code": "schema-invalid" }
  ],
  "generated": [
    {
      "id": "message-too-large",
      "base": "event-touch.json",
      "inflatePayloadChars": 70000,
      "expect": "error",
      "code": "message-too-large",
      "note": "§11 MAX_MESSAGE_BYTES = 65536; generated in-test so no oversized blob is committed"
    },
    {
      "id": "payload-too-large",
      "base": "event-touch.json",
      "inflatePayloadChars": 40000,
      "expect": "error",
      "code": "payload-too-large",
      "note": "§11 MAX_PAYLOAD_BYTES = 32768; the size check runs before the per-string check"
    },
    {
      "id": "malformed-json",
      "raw": "{\"specVersion\":\"aip/1.0\",\"messageId\":\"do-not-echo-this-token\"",
      "expect": "error",
      "code": "schema-invalid",
      "mustNotEcho": ["do-not-echo-this-token"],
      "note": "§5 parser errors must not echo caller input"
    },
    {
      "id": "empty-body",
      "raw": "",
      "expect": "error",
      "code": "schema-invalid"
    },
    {
      "id": "json-array-not-object",
      "raw": "[{\"specVersion\":\"aip/1.0\"}]",
      "expect": "error",
      "code": "schema-invalid"
    }
  ],
