          "const": "expired",
          "description": "終態：`expiresAt` 已過、未播。",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "終態：協商結果 `unsupported`。",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "終態：adapter 回報失敗。",
          "type": "string"
        },
        {
          "const": "uncertain",
          "description": "終態：結果未知（crash／斷線／acknowledged 逾時／watchdog）。",
          "type": "string"
