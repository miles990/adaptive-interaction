        {
          "const": "scheduled",
          "description": "adapter 已排程。",
          "type": "string"
        },
        {
          "const": "started",
          "description": "adapter 已開始演出。",
          "type": "string"
        },
        {
          "const": "completed",
          "description": "終態：呈現演完了（≠ 外部工作 verified）。",
          "type": "string"
