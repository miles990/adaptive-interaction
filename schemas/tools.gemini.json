  "tools": [
    {
      "functionDeclarations": [
        {
          "description": "Check that the interaction runtime is reachable and get its current state (emergency stop, session, counters).",
          "name": "interaction_status",
          "parameters": {
            "properties": {},
            "required": [],
            "type": "object"
          }
        },
        {
          "description": "Discover the current receptors, actuators, tool operations, constraints and session policy. Always call before planning; never assume a device exists.",
          "name": "interaction_capabilities",
          "parameters": {
            "properties": {
              "includeUnavailable": {
                "type": "boolean"
              }
            },
            "required": [],
            "type": "object"
          }
        },
        {
          "description": "Query recent observations (optionally one receptor, freshness-bounded). Facts and inferences are separate; treat low-confidence inferences as guesses.",
          "name": "interaction_observe",
          "parameters": {
            "properties": {
              "fresh": {
                "description": "Read live from the receptor instead of the store",
                "type": "boolean"
              },
              "limit": {
                "maximum": 500,
                "minimum": 1,
                "type": "integer"
              },
              "maxAgeMs": {
                "minimum": 0,
                "type": "integer"
              },
              "receptorId": {
                "type": "string"
              }
            },
            "required": [],
            "type": "object"
          }
        },
        {
          "description": "Create an interaction plan from a semantic intent. The deterministic policy governor bounds every parameter later; magnitudes are suggestions only. The plan may legitimately choose no action.",
          "name": "interaction_plan",
          "parameters": {
            "properties": {
              "allowNoAction": {
                "type": "boolean"
              },
              "candidates": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "durationMs": {
                "minimum": 0,
                "type": "integer"
              },
              "intent": {
                "description": "Semantic intent, e.g. celebrate-progress, warning",
                "type": "string"
              },
              "magnitude": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "maxChannels": {
                "minimum": 1,
                "type": "integer"
              },
              "message": {
                "type": "string"
              },
              "minChannels": {
                "minimum": 0,
                "type": "integer"
              },
              "preferredChannels": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "intent"
            ],
            "type": "object"
          }
        },
        {
          "description": "Dry-run a plan through the policy governor: returns per-step decisions and effective bounded parameters without any side effect.",
          "name": "interaction_simulate",
          "parameters": {
            "properties": {
              "planId": {
                "type": "string"
              }
            },
            "required": [
              "planId"
            ],
            "type": "object"
          }
        },
        {
          "description": "Execute an authorized plan. Returns action receipts. IMPORTANT: an accepted/queued receipt is NOT completion — poll action_status or verify.",
          "name": "interaction_execute",
          "parameters": {
            "properties": {
              "dryRun": {
                "type": "boolean"
              },
              "planId": {
                "type": "string"
              }
            },
            "required": [
              "planId"
            ],
            "type": "object"
          }
        },
        {
          "description": "Get the full receipt (state machine history) of one action.",
          "name": "interaction_action_status",
          "parameters": {
            "properties": {
              "actionId": {
                "type": "string"
              }
            },
            "required": [
              "actionId"
            ],
            "type": "object"
          }
        },
        {
          "description": "Re-verify an action against fresh observations and update its receipt (observed / uncertain).",
          "name": "interaction_verify",
          "parameters": {
            "properties": {
              "actionId": {
                "type": "string"
              }
            },
            "required": [
              "actionId"
            ],
            "type": "object"
          }
        },
        {
          "description": "Cancel a queued or running action.",
          "name": "interaction_cancel",
          "parameters": {
            "properties": {
              "actionId": {
                "type": "string"
              }
            },
            "required": [
              "actionId"
            ],
            "type": "object"
          }
        },
        {
          "description": "EMERGENCY STOP: cancel every open action and halt all actuators immediately. Never requires approval; does not auto-resume.",
          "name": "interaction_stop",
          "parameters": {
            "properties": {
              "reason": {
                "type": "string"
              }
            },
            "required": [],
            "type": "object"
          }
        },
        {
          "description": "Manually run one recipe (its trigger conditions are bypassed; policy still applies).",
          "name": "interaction_recipe_run",
          "parameters": {
            "properties": {
              "recipeId": {
                "type": "string"
              }
            },
            "required": [
              "recipeId"
            ],
            "type": "object"
          }
        },
        {
          "description": "Read the effective policy (limits, quiet hours, allowlists, initiative).",
          "name": "interaction_policy",
          "parameters": {
            "properties": {},
            "required": [],
            "type": "object"
          }
        },
        {
          "description": "Search the knowledge graph (FTS + lexical-vector CANDIDATE retrieval; results are candidates, not truth). Read-only.",
          "name": "interaction_knowledge_search",
          "parameters": {
            "properties": {
              "k": {
                "maximum": 50,
                "minimum": 1,
                "type": "integer"
              },
              "query": {
                "type": "string"
              }
            },
            "required": [
              "query"
            ],
            "type": "object"
          }
        },
        {
          "description": "Read one knowledge node (status shows candidate/active/stale/disputed/superseded honestly).",
          "name": "interaction_knowledge_get",
          "parameters": {
            "properties": {
              "nodeId": {
                "type": "string"
              }
            },
            "required": [
              "nodeId"
            ],
            "type": "object"
          }
        },
        {
          "description": "Read a source asset's metadata and (for text) a capped content preview. Raw assets are immutable.",
          "name": "interaction_knowledge_get_source",
          "parameters": {
            "properties": {
              "hash": {
                "type": "string"
              }
            },
            "required": [
              "hash"
            ],
            "type": "object"
          }
        },
        {
          "description": "Expand one node's neighborhood (edges + neighbor summaries).",
          "name": "interaction_knowledge_expand_graph",
          "parameters": {
            "properties": {
              "root": {
                "type": "string"
              }
            },
            "required": [
              "root"
            ],
            "type": "object"
          }
        },
        {
          "description": "Propose an ENTITY node. AI proposals always land as CANDIDATE — a human review activates them.",
          "name": "interaction_knowledge_propose_entity",
          "parameters": {
            "properties": {
              "content": {
                "type": "string"
              },
              "domains": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "content"
            ],
            "type": "object"
          }
        },
        {
          "description": "Propose a CLAIM with evidence (asset hash/URL + segment REQUIRED). Always a CANDIDATE; never activates itself.",
          "name": "interaction_knowledge_propose_claim",
          "parameters": {
            "properties": {
              "confidence": {
                "type": "number"
              },
              "content": {
                "type": "string"
              },
              "counterexamples": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "domains": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "evidence": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "content",
              "evidence"
            ],
            "type": "object"
          }
        },
        {
          "description": "Propose a typed relation. Analogy/conjecture origins can NEVER claim causality; AI proposals are candidates.",
          "name": "interaction_knowledge_propose_relation",
          "parameters": {
            "properties": {
              "confidence": {
                "type": "number"
              },
              "from": {
                "type": "string"
              },
              "origin": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
              "relation": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to",
              "relation",
              "origin"
            ],
            "type": "object"
          }
        },
        {
          "description": "Propose a new version that would supersede an existing node. The old node is only superseded when a HUMAN approves.",
          "name": "interaction_knowledge_propose_supersede",
          "parameters": {
            "properties": {
              "applicability": {
                "type": "string"
              },
              "confidence": {
                "type": "number"
              },
              "content": {
                "type": "string"
              },
              "counterexamples": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "domains": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "evidence": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "supersedes": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "supersedes",
              "title",
              "content",
              "evidence",
              "domains"
            ],
            "type": "object"
          }
        },
        {
          "description": "Add a review COMMENT to a candidate. An AI can comment but can never approve/reject — that stays human.",
          "name": "interaction_knowledge_submit_review",
          "parameters": {
            "properties": {
              "nodeId": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "nodeId",
              "note"
            ],
            "type": "object"
          }
        }
      ]
    }
  ]
}
