{
  "$defs": {
    "Activity": {
      "description": "§3 `activity` 詞彙（7）。",
      "type": "string",
      "x-knownValues": [
        "idle",
        "reacting",
        "working",
        "waiting",
        "celebrating",
        "resting",
        "frozen"
      ]
    },
    "Attention": {
      "description": "§3 `attention`。序列化為 internally tagged：`{\"kind\":\"none\"}`、\n`{\"kind\":\"member\",\"id\":\"device:…\"}`、`{\"kind\":\"task\",\"correlationId\":\"…\"}`。",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "member",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "correlationId": {
              "type": "string"
            },
            "kind": {
              "const": "task",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "correlationId"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "not": {
                "enum": [
                  "none",
                  "member",
                  "task"
                ]
              },
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "LastInteraction": {
      "additionalProperties": true,
      "description": "§3 `lastInteraction`。",
      "properties": {
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "source",
        "at"
      ],
      "type": "object"
    },
    "MemberRole": {
      "description": "參與方角色。",
      "type": "string",
      "x-knownValues": [
        "host-renderer",
        "remote-renderer",
        "input-device",
        "observer"
      ]
    },
    "MemberView": {
      "additionalProperties": true,
      "description": "§3 `members[]`：共享狀態裡的成員投影。\n\n**不含**協商結果的細節（`NegotiatedCapabilities` 是 host 私有），只投影一件所有人都需要\n知道的事實：這個成員把哪些 Behavior Intent 協商成 `unsupported`。沒有它，桌面與 iPhone\n只能顯示「能力核對中」——契約 §11 的「部分能力目前不可用」永遠不會被觸發。\n沒有任何不支援的 intent 時是**空陣列**（不是缺鍵），這樣接收端不必區分「都支援」與「不知道」。",
      "properties": {
        "lastSeenAt": {
          "format": "date-time",
          "type": "string"
        },
        "party": {
          "$ref": "#/$defs/Party"
        },
        "presence": {
          "$ref": "#/$defs/Presence"
        },
        "role": {
          "$ref": "#/$defs/MemberRole"
        },
        "unsupportedIntents": {
          "default": [],
          "description": "協商為 `unsupported` 的 intent 名（排序穩定：來自 `BTreeMap`）。\n`default` 是為了讓這個欄位出現之前寫下的持久化 snapshot 仍然還原得回來。",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "party",
        "role",
        "presence",
        "lastSeenAt"
      ],
      "type": "object"
    },
    "Mood": {
      "additionalProperties": true,
      "description": "§3 `mood`。`intensity` 恆為 0..=1 且四捨五入到 3 位小數（保證 canonical JSON 穩定）。",
      "properties": {
        "intensity": {
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number",
          "x-nonNegativeZero": true
        },
        "kind": {
          "$ref": "#/$defs/MoodKind"
        }
      },
      "required": [
        "kind",
        "intensity"
      ],
      "type": "object"
    },
    "MoodKind": {
      "description": "§3 `mood.kind` 詞彙（7）。",
      "type": "string",
      "x-knownValues": [
        "neutral",
        "happy",
        "playful",
        "proud",
        "tired",
        "alert",
        "down"
      ]
    },
    "Party": {
      "description": "參與方參照。**只是宣稱**；可信身分由 Transport 綁定後比對（§5）。",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PartyKind"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "PartyKind": {
      "description": "訊息／能力的參與方種類。未知值 → [`PartyKind::Unknown`]（保留原字串）。",
      "type": "string",
      "x-knownValues": [
        "runtime",
        "session",
        "device",
        "renderer",
        "human-surface",
        "human",
        "agent"
      ]
    },
    "Presence": {
      "description": "Session membership 的 presence（§2 由 Session Host 擁有）。",
      "type": "string",
      "x-knownValues": [
        "online",
        "reconnecting",
        "offline"
      ]
    },
    "TruthState": {
      "description": "§4.2 truthState（15）。只由 Runtime 設定；`verified` 只能來自人類驗證路徑。",
      "type": "string",
      "x-knownValues": [
        "none",
        "queued",
        "working",
        "waiting-input",
        "waiting-consent",
        "blocked",
        "claimed",
        "verified",
        "failed",
        "timed-out",
        "expired",
        "unknown",
        "cancelled",
        "emergency",
        "offline"
      ]
    },
    "TruthView": {
      "additionalProperties": true,
      "description": "§3 `truth`。**只有** Runtime 的真相事件能改；Session 只轉錄，不推論。",
      "properties": {
        "correlationId": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/TruthState"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/miles990/adaptive-interaction/schemas/semantic-state-1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "§3 權威語意狀態。欄位是 `pub(crate)`：**只有** [`crate::CharacterSession`] 能改\n（§2「`SemanticState` 只有 `CharacterSession::apply` 能改」），對外只有 getter 與 `Serialize`。",
  "profile": "semantic-state/1.0",
  "properties": {
    "activity": {
      "$ref": "#/$defs/Activity"
    },
    "attention": {
      "$ref": "#/$defs/Attention"
    },
    "characterId": {
      "type": "string"
    },
    "lastInteraction": {
      "$ref": "#/$defs/LastInteraction"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/MemberView"
      },
      "maxItems": 16,
      "type": "array"
    },
    "mood": {
      "$ref": "#/$defs/Mood"
    },
    "reducedMotion": {
      "type": "boolean"
    },
    "truth": {
      "$ref": "#/$defs/TruthView"
    }
  },
  "required": [
    "characterId",
    "mood",
    "activity",
    "attention",
    "truth",
    "members",
    "reducedMotion"
  ],
  "title": "SemanticState",
  "type": "object",
  "x-limits": {
    "maxBytes": 32768,
    "maxDepth": 7,
    "maxStringChars": 2000,
    "noNull": true
  }
}
