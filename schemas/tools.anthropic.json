{
  "companionPolicy": {
    "note": "Metadata not expressible in the host tool format; hosts should enforce approval flags before invoking.",
    "schemaVersion": "1.0",
    "tools": [
      {
        "canonicalName": "interaction.status",
        "externalSideEffect": false,
        "name": "interaction_status",
        "requiresApproval": false,
        "reversible": true,
        "risk": "read-only",
        "roles": [
          "receptor"
        ]
      },
      {
        "canonicalName": "interaction.capabilities",
        "externalSideEffect": false,
        "name": "interaction_capabilities",
        "requiresApproval": false,
        "reversible": true,
        "risk": "read-only",
        "roles": [
          "receptor"
        ]
      },
      {
        "canonicalName": "interaction.observe",
        "externalSideEffect": false,
        "name": "interaction_observe",
        "requiresApproval": false,
        "reversible": true,
        "risk": "read-only",
        "roles": [
          "receptor"
        ]
      },
      {
        "canonicalName": "interaction.plan",
        "externalSideEffect": false,
        "name": "interaction_plan",
        "requiresApproval": false,
        "reversible": true,
        "risk": "low",
        "roles": [
          "actuator"
        ]
      },
      {
        "canonicalName": "interaction.simulate",
        "externalSideEffect": false,
        "name": "interaction_simulate",
        "requiresApproval": false,
        "reversible": true,
        "risk": "read-only",
        "roles": [
          "receptor"
        ]
      },
      {
        "canonicalName": "interaction.execute",
        "externalSideEffect": false,
        "name": "interaction_execute",
        "requiresApproval": false,
        "reversible": false,
        "risk": "bounded-side-effect",
        "roles": [
          "actuator"
        ]
      },
      {
        "canonicalName": "interaction.action_status",
        "externalSideEffect": false,
        "name": "interaction_action_status",
        "requiresApproval": false,
        "reversible": true,
        "risk": "read-only",
        "roles": [
          "receptor"
        ]
      },
      {
        "canonicalName": "interaction.verify",
        "externalSideEffect": false,
        "name": "interaction_verify",
        "requiresApproval": false,
        "reversible": true,
        "risk": "low",
        "roles": [
          "receptor",
          "actuator"
        ]
      },
      {
        "canonicalName": "interaction.cancel",
        "externalSideEffect": false,
        "name": "interaction_cancel",
        "requiresApproval": false,
